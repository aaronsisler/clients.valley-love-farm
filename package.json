{
  "name": "valley-love-farm",
  "version": "2.0.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "prebuild": "rm -rf ./build",
    "build": "next build ./src",
    "dev": "next ./src",
    "deploy": "aws s3 sync ./build s3://$S3_BUCKET --delete && aws cloudfront create-invalidation --distribution-id $CLOUDFRONT_DISTRIBUTION_ID --paths \"/*\"",
    "lint": "eslint .",
    "lint:styles": "stylelint \"src/**/*.scss\"",
    "prepare": "husky"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@hookform/resolvers": "^5.9.1",
    "@mui/icons-material": "^9.3.1",
    "@mui/material": "^9.3.1",
    "axios": "^1.19.0",
    "classnames": "^2.5.1",
    "email-validator": "^2.0.4",
    "next": "^16.3.3",
    "prop-types": "^15.8.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.86.0",
    "react-tabs": "^6.1.1",
    "sass": "^1.103.1",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "stylelint": "^17.14.1",
    "stylelint-config-rational-order": "^0.1.2",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-order": "^8.1.1"
  }
}
